{
  "local-guardrails": {
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|list_dir|find_by_name|grep_search|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x ./hooks/guard-agy.sh ]; then ./hooks/guard-agy.sh; else ./.agents/hooks/guard-agy.sh; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
